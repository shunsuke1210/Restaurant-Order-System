# Supabase プロジェクトの公開URL・匿名キー（ブラウザに露出してよい値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 厨房/レジタブレットの初回デバイスプロビジョニング（/setup/[role]、
# 0007_provision_device.sqlのprovision_device RPC）で使用する共有シークレット。
# 検証は必ずPostgres関数（provision_device）の内部でのみ行う。ローカル開発では
# supabase/config.tomlの[db.vault]がこの値を`supabase start`/`db reset`のたびに
# Supabase Vaultへ登録し（env()置換）、provision_deviceがそこから読み取って照合する。
# 実際の値はここに記載せず、各環境の .env.local 等で管理する。
# 本番/クラウド環境ではconfig.tomlのenv()置換は適用されないため、初回セットアップ時に
# 一度だけ手動でVaultシークレットを投入する運用作業が別途必要
# （詳細は0007_provision_device.sqlのマイグレーションコメント参照）。
DEVICE_SETUP_CODE=

# 単一店舗前提のv1で、/setup/[role]がdevices行を登録する対象のstores.id。
# stores/tablesの初期データ投入自体は本spec範囲外の手動作業のため
# （design.md Non-Goals/Out of Boundary参照）、運用者が店舗行を作成した後、
# そのidをここに設定する。秘匿情報ではないためNEXT_PUBLIC_接頭辞で公開してよい。
NEXT_PUBLIC_STORE_ID=
